# Copy this file to ".env" and change the values you need.
# Never put the real .env file in Git.

# "development" (default) or "production"
SPORTSMATE_ENV=development

# Secret used to sign login cookies. REQUIRED in production.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
# In development you can leave it empty: a key is created in instance/secret_key.
SECRET_KEY=

# Where the SQLite database file is (default: sportsmate.db next to app.py)
# DATABASE_PATH=sportsmate.db

# Where database backups are written before an upgrade (default: backups/)
# BACKUP_DIR=backups

# Development server (python app.py)
SPORTSMATE_HOST=127.0.0.1
SPORTSMATE_PORT=5000
# 1 shows the Flask debugger. Only use it on your own computer, never on a network.
SPORTSMATE_DEBUG=0

# Set to 1 when the site runs on HTTPS (always in production)
SESSION_COOKIE_SECURE=0

# How many days a login lasts
SESSION_DAYS=14

# Set to 1 only behind a reverse proxy (nginx, Render, Railway, ...)
TRUST_PROXY=0
